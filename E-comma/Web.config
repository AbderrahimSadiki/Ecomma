<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
    <section name="entityFramework" type="System.Data.Entity.Internal.ConfigFile.EntityFrameworkSection, EntityFramework, Version=6.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" requirePermission="false" />
  </configSections>
  
  <!-- ========================================
       CHAÎNES DE CONNEXION
       ======================================== -->
  <connectionStrings>
    <!-- 
    Configuration pour SQL Server local (SQLEXPRESS)
    Remplacez les valeurs selon votre configuration
    -->
    
    <!-- Option 1 : Authentification Windows (Recommandée) -->
    <add name="DefaultConnection" 
         connectionString="Data Source=ISOX64\SQLEXPRESS;Initial Catalog=E-commaDb;Integrated Security=True;TrustServerCertificate=True;" 
         providerName="System.Data.SqlClient" />
    
    <!-- Option 2 : Authentification SQL Server -->
    <!--
    <add name="EcommerceDB" 
         connectionString="Server=localhost\SQLEXPRESS;Database=EcommerceDB;User Id=sa;Password=votre_password;TrustServerCertificate=True;" 
         providerName="System.Data.SqlClient" />
    -->
  </connectionStrings>
  
  <appSettings>
    <add key="webpages:Version" value="3.0.0.0" />
    <add key="webpages:Enabled" value="false" />
    <add key="ClientValidationEnabled" value="true" />
    <add key="UnobtrusiveJavaScriptEnabled" value="true" />
    <add key="SMTP_Host" value="smtp.gmail.com" />
    <add key="SMTP_Port" value="587" />
    <add key="SMTP_User" value="isolupo00@gmail.com" />
    <add key="SMTP_Pass" value="enad suxn wnal urdf" />
    <add key="SMTP_EnableSsl" value="true" />
  </appSettings>
  
  <system.web>
    <compilation debug="true" targetFramework="4.8" />
	  <globalization
      requestEncoding="utf-8"
      responseEncoding="utf-8"
      culture="fr-FR"
      uiCulture="fr" /> 
    <httpRuntime targetFramework="4.8" maxRequestLength="10240" />
    <sessionState mode="InProc" timeout="60" />
    <authentication mode="Forms">
      <forms loginUrl="~/Login.aspx" timeout="60" slidingExpiration="true" />
    </authentication>
    <customErrors mode="Off" />
  </system.web>
  
  <system.webServer>
    <modules runAllManagedModulesForAllRequests="true" />
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="10485760" />
      </requestFiltering>
    </security>
    <httpErrors errorMode="Detailed" />
  </system.webServer>
  
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="Newtonsoft.Json" publicKeyToken="30ad4fe6b2a6aeed" />
        <bindingRedirect oldVersion="0.0.0.0-13.0.0.0" newVersion="13.0.0.0" />
      </dependentAssembly>
    </assemblyBinding>
  </runtime>
  
  <entityFramework>
    <providers>
      <provider invariantName="System.Data.SqlClient" type="System.Data.Entity.SqlServer.SqlProviderServices, EntityFramework.SqlServer" />
    </providers>
  </entityFramework>
</configuration>